# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=keys/service-account.json

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Database Configuration (Optional - defaults to SQLite for local development)
# DATABASE_URL=postgresql://user:password@localhost:5432/gtm_db

# Workspace integration credentials (HubSpot, etc.) are encrypted at rest with this key.
# Must be a Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Falls back to a key derived from SECRET_KEY if unset -- fine for local dev, but set an
# explicit value in production so credentials survive a SECRET_KEY rotation.
# INTEGRATION_ENCRYPTION_KEY=

# Cloud Storage Configuration (Optional)
# GCS_BUCKET_NAME=your-gcp-bucket-name

# Gemini API is automatically enabled via Google Cloud credentials
# No additional API key needed - uses service account from GOOGLE_APPLICATION_CREDENTIALS
