# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Cloud Platform (GCP) Configuration
GOOGLE_APPLICATION_CREDENTIALS=keys/service-account.json
GCP_PROJECT_ID=your-gcp-project-id

# Database Configuration
# Local Development: Uses SQLite by default
# Production: Use Cloud SQL or PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/gtm_db

# Cloud SQL Connection (GCP Production)
# Format: postgresql://user:password@/database?unix_socket_dir=/cloudsql/INSTANCE_CONNECTION_NAME
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

# Cloud Storage Configuration (GCP)
# Used for file uploads and strategic evidence storage
GCS_BUCKET_NAME=your-gcp-bucket-name
GCS_MEDIA_ROOT=media/

# OpenAI Configuration (for AI-powered insights)
OPENAI_API_KEY=your-openai-api-key

# Environment Setting
ENVIRONMENT=development  # Options: development, production, staging
