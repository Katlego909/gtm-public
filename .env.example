# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-generate-with-get-random-secret-key
DEBUG=False
ALLOWED_HOSTS=yourusername.pythonanywhere.com,localhost,127.0.0.1

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

# Email Settings (Gmail)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password

# Optional: Redirect all emails to yourself for testing
# EMAIL_REDIRECT_TO=your-testing-email@gmail.com

# Optional: Use console backend for email testing (prints to terminal)
# EMAIL_CONSOLE=true

# Optional: NPM path (only needed for local Tailwind development)
# NPM_BIN_PATH=C:\Program Files\nodejs\npm.cmd

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost/dbname
