# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here

# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=keys/service-account.json

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Database Configuration (Optional - defaults to SQLite for local development)
# DATABASE_URL=postgresql://user:password@localhost:5432/gtm_db

# Cloud Storage Configuration (Optional)
# GCS_BUCKET_NAME=your-gcp-bucket-name

# Gemini API is automatically enabled via Google Cloud credentials
# No additional API key needed - uses service account from GOOGLE_APPLICATION_CREDENTIALS
